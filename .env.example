# Server-side only. Never prefix these with NEXT_PUBLIC_.
#
# IMPORTANT: JSONBin keys look like  $2a$10$AbC...  Next.js treats $ as a variable
# reference in .env files, so you MUST escape every $ with a backslash:
#   JSONBIN_API_KEY=\$2a\$10\$AbC...
# Copy this file to .env.local and fill in real values.

# Your JSONBin Master Key (sent as X-Master-Key)
JSONBIN_API_KEY=your_jsonbin_api_key

# The ID of the private bin that stores your library
JSONBIN_BIN_ID=your_jsonbin_bin_id

# OPTIONAL: a scoped Access Key (sent as X-Access-Key instead of the master key).
# It needs Bins Read + Bins Update permission. If set, it is used in place of JSONBIN_API_KEY.
# JSONBIN_ACCESS_KEY=your_jsonbin_access_key
